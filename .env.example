# MicroRCA-Agent Environment Configuration
# Copy this file to `.env` and fill in the API key for your chosen LLM provider.
# NEVER commit `.env` or hardcode API keys in source files.

# OpenAI / OpenAI-compatible (e.g. Groq, Together, vLLM, Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5
